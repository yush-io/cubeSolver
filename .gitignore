# adapted/inpsired by https://github.com/github/gitignore/blob/main/Unity.gitignore
# and gitignore.io 
# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild*/
[Bb]uilds*/
[Ll]ogs/
/[Mm]emoryCaptures/
UserSettings/
MemoryCaptures/
Recordings/
sysinfo.txt

# Visual Studio / Rider files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb

# Autogenerated by Unity
ExportedObj/
*.apk
*.aab
*.unitypackage
.crash/
*.pid
*.stackdump

# Package cache
Packages/com.unity.package-manager.cache/

# Python / backend generated files
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
cubeenv/
backend/debug_uploads/
debug_uploads/
backend_launcher.log

# macOS
.DS_Store

# Web frontend
web-demo/node_modules/
web-demo/dist/
web-demo/.env.local
web-demo/*.tsbuildinfo
web-demo/vite.config.js
web-demo/vite.config.d.ts
